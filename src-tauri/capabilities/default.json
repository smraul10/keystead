{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-vault-status",
    "allow-create-vault",
    "allow-unlock-vault",
    "allow-vault-items",
    "allow-save-vault",
    "allow-download-icon",
    "allow-copy-to-clipboard",
    "allow-clear-clipboard",
    "allow-set-window-theme",
    "allow-lock-vault"
  ]
}
